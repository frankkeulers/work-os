{
  "name": "work-os",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Work OS: local Slack triage and filing assistant. Frontend prototype on mock data.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @work-os/web",
    "build": "npm run typecheck -w @work-os/shared && npm run build -w @work-os/web",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "npm run e2e -w @work-os/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
